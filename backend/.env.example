# Application Environment Variables
PROJECT_NAME="SIH26188 Document Screening System"
ENVIRONMENT="development"
DEBUG=true
# Validation Mode: 'development' (enables registered synthetic test fixtures) or 'production' (STRICT validation only)
DOCUMENT_VALIDATION_MODE="development"
API_V1_STR="/api/v1"
SECRET_KEY="sih26188-prototype-development-secret-key-change-in-production"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://127.0.0.1:3000","http://127.0.0.1:8501"]

# Storage & Database
DATABASE_URL="sqlite+aiosqlite:///../../database/screening_audit.db"
MOCK_INTEL_DB_PATH="../../database/mock_intelligence.db"
UPLOAD_DIR="../../data/uploads"
OUTPUT_DIR="../../data/outputs"
MAX_UPLOAD_SIZE_MB=100

# Model Weights Paths
DOCTAMPER_MODEL_PATH="../../models/doctamper/doctamper_base.onnx"
TRUFOR_MODEL_PATH="../../models/trufor/trufor_baseline.onnx"
INSIGHTFACE_MODEL_PATH="../../models/face/arcface_r100.onnx"

# Screening Thresholds
QUALITY_MIN_SCORE=0.60
FACE_MATCH_THRESHOLD=0.65
TAMPER_ALERT_THRESHOLD=0.45
RISK_THRESHOLD_CLEAR=29
RISK_THRESHOLD_REVIEW=69
